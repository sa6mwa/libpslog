package = "lua-pslog"
version = "@VERSION@-1"
source = {
  url = "@SOURCE_URL@",
@SOURCE_TAG_LINE@
}
description = {
  summary = "Lua binding for libpslog",
  detailed = [[
Go-style Lua logging binding for libpslog. The module is required as "pslog"
inside Lua and links its C binding against the public libpslog shared library.
]],
  homepage = "https://github.com/sa6mwa/libpslog",
  license = "MIT",
}
dependencies = {
  "lua >= 5.5, < 5.6",
}
external_dependencies = {
  LIBPSLOG = {
    header = "pslog.h",
    library = "pslog",
  },
}
build = {
  type = "builtin",
  variables = {
    CFLAGS = "$(CFLAGS) -std=c99 -pthread",
    LDFLAGS = "$(LDFLAGS) -pthread",
  },
  install = {
    lua = {
      "include/pslog_lua.h",
    },
  },
  modules = {
    ["pslog.core"] = {
      sources = {
        "lua/src/pslog_lua.c",
      },
      defines = {
        "PSLOG_VERSION_MAJOR=@PSLOG_VERSION_MAJOR@",
        "PSLOG_VERSION_MINOR=@PSLOG_VERSION_MINOR@",
        "PSLOG_VERSION_PATCH=@PSLOG_VERSION_PATCH@",
        "PSLOG_VERSION_STRING=\"@VERSION@\"",
        "_POSIX_C_SOURCE=200809L",
      },
      incdirs = {
        "include",
        "$(LIBPSLOG_INCDIR)",
      },
      libdirs = {
        "$(LIBPSLOG_LIBDIR)",
      },
      libraries = {
        "pslog",
        "pthread",
      },
    },
    ["pslog"] = "lua/pslog/init.lua",
  },
}
