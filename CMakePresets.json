{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "PSLOG_DEPENDENCY_MODE": "bundled-sdk",
        "PSLOG_BUILD_TESTS": "ON",
        "PSLOG_BUILD_BENCHMARKS": "ON",
        "PSLOG_BUILD_LUA": "OFF",
        "PSLOG_BUILD_FUZZ": "OFF"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-x86_64-gnu.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "debug-lua",
      "inherits": "debug",
      "cacheVariables": { "PSLOG_BUILD_LUA": "ON" }
    },
    {
      "name": "host",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-x86_64-gnu.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "x86_64-linux-gnu-release",
      "inherits": "host",
      "cacheVariables": { "PSLOG_TARGET_ID": "x86_64-linux-gnu" }
    },
    {
      "name": "x86_64-linux-musl-release",
      "inherits": "host",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-x86_64-musl.cmake",
      "cacheVariables": { "PSLOG_TARGET_ID": "x86_64-linux-musl" }
    },
    {
      "name": "aarch64-linux-gnu-release",
      "inherits": "host",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-aarch64-gnu.cmake",
      "cacheVariables": { "PSLOG_TARGET_ID": "aarch64-linux-gnu" }
    },
    {
      "name": "aarch64-linux-musl-release",
      "inherits": "host",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-aarch64-musl.cmake",
      "cacheVariables": { "PSLOG_TARGET_ID": "aarch64-linux-musl" }
    },
    {
      "name": "armhf-linux-gnu-release",
      "inherits": "host",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-armhf-gnu.cmake",
      "cacheVariables": { "PSLOG_TARGET_ID": "armhf-linux-gnu" }
    },
    {
      "name": "armhf-linux-musl-release",
      "inherits": "host",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-armhf-musl.cmake",
      "cacheVariables": { "PSLOG_TARGET_ID": "armhf-linux-musl" }
    },
    {
      "name": "arm64-apple-darwin-release",
      "inherits": "host",
      "toolchainFile": "${sourceDir}/cmake/toolchains/arm64-apple-darwin.cmake",
      "cacheVariables": { "PSLOG_TARGET_ID": "arm64-apple-darwin" }
    },
    {
      "name": "valgrind",
      "inherits": "debug",
      "cacheVariables": { "PSLOG_BUILD_BENCHMARKS": "OFF" }
    },
    {
      "name": "coverage",
      "inherits": "debug",
      "cacheVariables": {
        "PSLOG_ENABLE_COVERAGE": "ON",
        "PSLOG_BUILD_BENCHMARKS": "OFF",
        "PSLOG_BUILD_FUZZ": "OFF"
      }
    },
    {
      "name": "profile",
      "inherits": "host",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Profile",
        "CMAKE_C_FLAGS_PROFILE": "-O3 -g -pg -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS_PROFILE": "-pg",
        "CMAKE_SHARED_LINKER_FLAGS_PROFILE": "-pg"
      }
    },
    {
      "name": "fuzz",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-aflpp.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PSLOG_BUILD_FUZZ": "ON",
        "PSLOG_BUILD_BENCHMARKS": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "debug-lua", "configurePreset": "debug-lua" },
    { "name": "host", "configurePreset": "host" },
    { "name": "valgrind", "configurePreset": "valgrind" },
    { "name": "coverage", "configurePreset": "coverage" },
    { "name": "coverage-report", "configurePreset": "coverage", "targets": ["coverage-report"] },
    { "name": "format", "configurePreset": "debug", "targets": ["format"] },
    { "name": "profile", "configurePreset": "profile" },
    { "name": "fuzz", "configurePreset": "fuzz" },
    { "name": "x86_64-linux-gnu-release", "configurePreset": "x86_64-linux-gnu-release" },
    { "name": "x86_64-linux-musl-release", "configurePreset": "x86_64-linux-musl-release" },
    { "name": "aarch64-linux-gnu-release", "configurePreset": "aarch64-linux-gnu-release" },
    { "name": "aarch64-linux-musl-release", "configurePreset": "aarch64-linux-musl-release" },
    { "name": "armhf-linux-gnu-release", "configurePreset": "armhf-linux-gnu-release" },
    { "name": "armhf-linux-musl-release", "configurePreset": "armhf-linux-musl-release" },
    { "name": "arm64-apple-darwin-release", "configurePreset": "arm64-apple-darwin-release" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "debug-lua", "configurePreset": "debug-lua", "output": { "outputOnFailure": true } },
    { "name": "host", "configurePreset": "host", "output": { "outputOnFailure": true } },
    { "name": "valgrind", "configurePreset": "valgrind", "output": { "outputOnFailure": true } },
    { "name": "coverage", "configurePreset": "coverage", "output": { "outputOnFailure": true } },
    { "name": "profile", "configurePreset": "profile", "output": { "outputOnFailure": true } },
    { "name": "fuzz", "configurePreset": "fuzz", "output": { "outputOnFailure": true } },
    { "name": "x86_64-linux-gnu-release", "configurePreset": "x86_64-linux-gnu-release", "output": { "outputOnFailure": true } },
    { "name": "x86_64-linux-musl-release", "configurePreset": "x86_64-linux-musl-release", "output": { "outputOnFailure": true } },
    { "name": "aarch64-linux-gnu-release", "configurePreset": "aarch64-linux-gnu-release", "output": { "outputOnFailure": true } },
    { "name": "aarch64-linux-musl-release", "configurePreset": "aarch64-linux-musl-release", "output": { "outputOnFailure": true } },
    { "name": "armhf-linux-gnu-release", "configurePreset": "armhf-linux-gnu-release", "output": { "outputOnFailure": true } },
    { "name": "armhf-linux-musl-release", "configurePreset": "armhf-linux-musl-release", "output": { "outputOnFailure": true } }
  ]
}
